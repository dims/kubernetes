# Importing the generic API server, directly or transitively, pulls admission
# and etcd storage into the kubelet. The kubelet only needed it for the signal
# helpers, which now live in the stdlib-only pkg/server/signals package.
rules:
  - selectorRegexp: ^k8s[.]io/apiserver/pkg/server(/options)?$
    forbiddenPrefixes:
      - ''
    transitive: true
  # The kubelet evaluates no CEL expressions. cel-go and its antlr parser used
  # to arrive through the apiserver admission stack and cost the binary 2.4 MB.
  - selectorRegexp: ^(cel[.]dev/cel-go|github[.]com/antlr4-go/antlr/v4)(/|$)
    forbiddenPrefixes:
      - cel.dev/cel-go
      - github.com/antlr4-go/antlr/v4
    transitive: true
